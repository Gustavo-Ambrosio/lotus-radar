{
  "name": "lotus-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Radar de licitacoes de cultura do Parana (estado + municipios), com categorias e foco em editais abertos.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "coletar": "tsx scripts/coletar.ts",
    "processar": "tsx scripts/coletar.ts --offline",
    "reprocessar": "tsx scripts/reprocessar.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
