# ─────────────────────────────────────────────────────────────
# Lotus Radar — variaveis de ambiente
# Copie para .env.local (dev) e configure no painel do host (prod).
# NUNCA commite o .env real: ele esta no .gitignore.
# ─────────────────────────────────────────────────────────────

# URL publica da aplicacao. Usada em links de e-mail, redirecionamentos
# do Mercado Pago, RSS/ICS e validacao de origem de webhook.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Banco de dados ──────────────────────────────────────────
# Producao: Postgres gerenciado (Neon, Supabase, Railway...).
# Se ausente, o projeto usa PGlite embarcado em .pgdata/ (apenas dev).
# DATABASE_URL=postgresql://usuario:senha@host:5432/lotus

# Driver local explicito: "postgres" | "pglite"
# Em dev padrao e pglite quando nao ha DATABASE_URL.
# DB_DRIVER=pglite

# ── Sessao / auth ───────────────────────────────────────────
# Senha usada para assinar cookies de sessao. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obrigatoria em producao (32+ caracteres).
SESSION_SECRET=

# ── Mercado Pago (assinaturas) ──────────────────────────────
# https://www.mercadopago.com.br/developers/panel/app
# Tokens de TESTE sao IPs com prefixo TEST-.
MERCADOPAGO_ACCESS_TOKEN=
# Segredo do webhook (Settings > Webhooks > Secret). Valida a assinatura
# x-signature / x-request-id no POST /api/webhooks/mercadopago.
MERCADOPAGO_WEBHOOK_SECRET=

# URL opcional de retorno do checkout. Sem definir, usa
# /planos?checkout=retorno na URL publica acima.
# NEXT_PUBLIC_CHECKOUT_RETURN_URL=http://localhost:3000/planos?checkout=retorno

# ── E-mail (alertas de novas licitacoes) ────────────────────
# Provedor usado para os avisos de "nova licitacao batendo a sua busca".
# Vazio = e-mails sao registrados no console em vez de enviados (dev).
RESEND_API_KEY=
MAIL_FROM=Lotus Radar <alertas@lotusradar.com.br>

# ── Limites de plano ────────────────────────────────────────
# Vazio = limite base definido em src/billing/planos.ts
PLANO_LIMITE_BUSCAS_GRATIS=
